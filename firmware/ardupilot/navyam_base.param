# Navyam base parameters for Cube Orange(+), ArduCopter 4.5/4.6
# DRAFT, NOT FLOWN. Load in Mission Planner (Config > Full Parameter List > Load from file),
# compare every value against the allowed values shown there, write, then reboot.
# Names that changed between versions are noted. Lines starting with # are ignored.

# ---- EKF3 with SLAM as ExternalNav ----
AHRS_EKF_TYPE,3
EK2_ENABLE,0
EK3_ENABLE,1
VISO_TYPE,1
EK3_SRC1_POSXY,6
EK3_SRC1_VELXY,6
EK3_SRC1_POSZ,2
EK3_SRC1_VELZ,0
EK3_SRC1_YAW,6
COMPASS_USE,0
COMPASS_USE2,0
COMPASS_USE3,0
# 4.6+: GPS1_TYPE. On 4.5 use GPS_TYPE,0 instead.
GPS1_TYPE,0

# ---- Companion link: TELEM2 -> Jetson (ArduPilot DDS) ----
SERIAL2_PROTOCOL,45
SERIAL2_BAUD,921
DDS_ENABLE,1

# ---- Telemetry radio: TELEM1 -> 3DR radio (MAVLink2) ----
SERIAL1_PROTOCOL,2
SERIAL1_BAUD,57

# ---- MTF-01 optical flow + ToF (MAVLink). Set the port it is wired to, e.g. SERIAL4: ----
# SERIAL4_PROTOCOL,1
# SERIAL4_BAUD,115
FLOW_TYPE,5
RNGFND1_TYPE,10
RNGFND1_ORIENT,25
# 4.6+: RNGFND1_MAX,8 and RNGFND1_MIN,0.01. On 4.5: RNGFND1_MAX_CM,800 and RNGFND1_MIN_CM,1

# ---- RC receiver ----
# Today (dev mule): FlySky FS-iA6B on the Cube's RCIN port, iBUS or PPM (ArduPilot autodetects).
#   The FS-iA6B only reports signal loss if a throttle failsafe value is set in the transmitter.
#   1. Mission Planner: Radio Calibration (note the throttle minimum, e.g. ~1000).
#   2. Transmitter failsafe menu: set CH3 (throttle) failsafe below that minimum, e.g. ~900.
#   3. FS_THR_VALUE between the two, e.g. 950 (below).
#   4. Props off: switch the transmitter off; Mission Planner must show "Radio" failsafe.
FS_THR_VALUE,950
# Competition frame: ELRS receiver (CRSF) for the TX16S on a serial port, e.g. SERIAL5:
# SERIAL5_PROTOCOL,23
# RSSI_TYPE,3

# ---- Motors ----
# Dev mule flies 4 x Holybro 40A ESCs: keep its current MOT_PWM_TYPE until the ESC model's
# DShot support is confirmed. Competition frame (JHEMCU 4-in-1, BLHeli_S): DShot600.
# MOT_PWM_TYPE,6

# ---- Failsafes required by the NIDAR brief ----
# RC link loss -> LAND
FS_THR_ENABLE,3
# EKF/SLAM failure -> LAND
FS_EKF_ACTION,1
# 6S thresholds under load
BATT_LOW_VOLT,21.0
BATT_CRT_VOLT,19.8
# Low battery -> SmartRTL or Land ("recall"); critical -> Land
BATT_FS_LOW_ACT,4
BATT_FS_CRT_ACT,1
# Geofence: max altitude + circle around home
FENCE_ENABLE,1
FENCE_TYPE,3
FENCE_ALT_MAX,2.0
FENCE_RADIUS,22
# FENCE_ACTION: pick "Brake or Land" from the value list for your firmware.

# ---- Guided-mode speed limits (indoors) ----
WPNAV_SPEED,50
WPNAV_ACCEL,100
